# SE Demo & POV Builder configuration. Copy to .env (git-ignored) and adjust.
# All settings are optional; defaults are shown.

# --- Server -----------------------------------------------------------------
# Loopback only by default. This tool has no user accounts; do not expose it on a
# network without your own access controls.
SEPB_HOST=127.0.0.1
SEPB_PORT=8000
# Optional static bearer token required on all /api routes except /api/health.
SEPB_API_TOKEN=
# Comma-separated origins allowed by CORS (the Vite dev server).
SEPB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SEPB_LOG_LEVEL=INFO

# --- Data & content -----------------------------------------------------------
# SQLite database lives in SEPB_DATA_DIR/sepb.db unless SEPB_DATABASE_URL is set.
SEPB_DATA_DIR=./data
SEPB_DATABASE_URL=
# Directory containing personas/, knowledge/, workflows/, adapters/ (default: tool root).
SEPB_CONTENT_DIR=
# Serve a built UI (frontend/dist) from the API server.
SEPB_FRONTEND_DIST=
# Allow loading the synthetic sample engagement.
SEPB_ALLOW_SAMPLE_DATA=true

# --- Integrations ---------------------------------------------------------------
# Only "mock" is supported. Live adapters are not implemented.
SEPB_ADAPTER_MODE=mock

# --- Optional LLM (off by default; no core feature depends on it) ----------------
# none | ollama | openai_compatible
SEPB_LLM_PROVIDER=none
# e.g. http://127.0.0.1:11434 for Ollama, or http://127.0.0.1:11434/v1 for its OpenAI-compatible API
SEPB_LLM_BASE_URL=
SEPB_LLM_MODEL=
# Only if your endpoint requires one. Never commit a real key.
SEPB_LLM_API_KEY=
SEPB_LLM_TIMEOUT_SECONDS=60
